<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uav_common</name>
  <version>0.1.0</version>
  <description>
    Shared plumbing for every UAV node: the parameter-file loader, the node
    lifecycle wrapper, parameter declaration and validation helpers, the
    freshness-gated stream cache, the autonomy-drop latch state machine, the
    geofence upload protocol, and geodesy. Contains NO nodes and no
    vehicle-specific policy.
  </description>
  <maintainer email="chase001cz@gmail.com">Team Inspiration</maintainer>
  <license>MIT</license>
  <url type="repository">https://github.com/InspirationRobotics/rx26_uav</url>

  <depend>rclpy</depend>
  <!-- param_utils builds ParameterDescriptors from these. rclpy pulls
       rcl_interfaces in transitively today, which is exactly why an undeclared
       dependency survives until the image changes. -->
  <depend>rcl_interfaces</depend>
  <!-- config.py asks ament where uav_bringup's share dir is, by NAME at
       runtime. That is deliberately not a build dependency on uav_bringup -
       bringup depends on the code packages, never the reverse. -->
  <depend>ament_index_python</depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
