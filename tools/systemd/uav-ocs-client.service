# /etc/systemd/system/uav-ocs-client.service  (Jetson host)
#
# TEMPLATE: __UAV_USER__ / __UAV_REPO__ / __UAV_CONTAINER__ are substituted by
# setup/install_jetson_host.sh at install time.
#
# Runs ocs_client — the 2 Hz heartbeat to the OCS at 192.168.8.107:37564 — inside the container.
#
# NOT PROVEN IN FLIGHT. This unit exists because nobody will SSH into this
# Jetson between flights, not because the node has earned it.
#     systemctl disable uav-ocs-client     # is the way back
#
# ---------------------------------------------------------------------------
# THE THREE-LAYER STOP, and why it is not one line.
#
# `docker exec` does not propagate termination: killing the exec client leaves
# the process running INSIDE the container. Without all three of the lines
# below, `systemctl restart` starts a second copy while the first still holds
# its resources, and the new one dies with an error that reads like a crash
# rather than like a leftover.
#
#   ExecStartPre  sweeps orphans BEFORE starting. This is the one that saves
#                 you, because it works even when the PREVIOUS stop failed.
#   ExecStart     run_in_container.sh also traps SIGTERM and forwards the kill
#                 inward, so the normal stop path works on its own.
#   ExecStop      backstop for when the wrapper itself is gone.
#
# The pkill pattern is the INSTALL-SPACE PATH, not the node name: matching on
# "ocs_client" alone would also match neighbouring node names and any editor
# or tail left open in the container. It must stay identical to the MARKER
# run_in_container.sh derives — that script prints it at startup so a mismatch
# is visible rather than silent.
#
# The leading `-` on both pkill lines is load-bearing: pkill exits 1 when it
# matches nothing, and without the `-` a perfectly clean start or stop fails.
#
# Verify with pgrep, not with "the page loaded":
#     systemctl restart uav-ocs-client
#     docker exec __UAV_CONTAINER__ pgrep -fc install/uav_groundstation/lib/uav_groundstation/ocs_client
#   must print exactly 1. Two = the sweep is not matching. Zero = wrong marker.
# ---------------------------------------------------------------------------
[Unit]
Description=UAV ocs_client (the 2 Hz heartbeat to the OCS at 192.168.8.107:37564)
After=uav-container.service
Requires=uav-container.service
# BindsTo, so stopping the container stops this too rather than leaving the
# unit restart-looping against a container that is gone.
BindsTo=uav-container.service

[Service]
Type=simple
User=__UAV_USER__
EnvironmentFile=-/etc/default/uav
Environment=UAV_CONTAINER=__UAV_CONTAINER__
ExecStartPre=-/usr/bin/docker exec __UAV_CONTAINER__ pkill -f install/uav_groundstation/lib/uav_groundstation/ocs_client
ExecStart=__UAV_REPO__/scripts/run_in_container.sh uav_groundstation ocs_client
ExecStop=-/usr/bin/docker exec __UAV_CONTAINER__ pkill -f install/uav_groundstation/lib/uav_groundstation/ocs_client
# Longer than the wrapper's 5 s SIGTERM grace plus its SIGKILL follow-up, so
# systemd does not shoot the wrapper while it is still tearing the node down.
TimeoutStopSec=15
# mixed: SIGTERM the wrapper (firing its trap), escalate to the cgroup after.
KillMode=mixed
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
