# /etc/systemd/system/uav-container.service  (Jetson host)
#
# TEMPLATE: __UAV_USER__ / __UAV_CONTAINER__ are substituted by
# setup/install_jetson_host.sh at install time.
#
# Starts the ROS 2 Humble container AFTER MAVProxy owns the Pixhawk, so no node
# ever races MAVProxy for the serial device.
#
# NOTE this is `docker start`, which CANNOT add or change bind mounts — those
# are fixed when the container is CREATED. If the workspace mount is missing,
# this unit cannot fix it; setup/install_jetson_host.sh checks and prints the
# `docker run` line instead.
[Unit]
Description=UAV ROS 2 Humble container
# uav-power BEFORE the container, not merely alongside it: the container
# bind-mounts /run/uav, which uav-power.service creates via RuntimeDirectory.
# Start the container first and Docker invents its own /run/uav on the host,
# which the helper then has to live with. Wants=, not Requires=, because a dead
# power helper should cost you the shutdown button and nothing else.
After=docker.service uav-mavproxy.service uav-power.service
Requires=docker.service
Wants=uav-mavproxy.service uav-power.service

[Service]
Type=simple
User=__UAV_USER__
ExecStart=/usr/bin/docker start -a __UAV_CONTAINER__
ExecStop=/usr/bin/docker stop -t 10 __UAV_CONTAINER__
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
